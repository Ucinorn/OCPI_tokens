DATABASE_URL=postgresql+psycopg://ocpi:ocpi@localhost:5432/ocpi
# Public URL the CPMS reaches this service on (used in OCPI versions/endpoints responses)
BASE_URL=http://localhost:8000
COUNTRY_CODE=GB
PARTY_ID=XXX
BUSINESS_NAME=OCPI Tokens
ISSUER=OCPI Tokens
# HTTP Basic auth for the admin UI, /api and /docs. OCPI endpoints use their own token auth. Empty password disables it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
